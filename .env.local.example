# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The search model MUST honour the googleSearch tool. Several models accept it
# and silently never call it, which turns every "grounded" result into recall.
# Verify with: npm run check-grounding
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Drafting the Letter of Inquiry needs no grounding, so a stronger model is fine.
# This is a preview id and is access-gated per project. If your key cannot call
# it the app retries on gemini-2.5-flash automatically, but you can also just
# set that here instead.
GEMINI_DRAFT_MODEL=gemini-3.1-pro-preview

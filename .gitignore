# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server logs
dev.out.log
dev.err.log
.vercel

# ...but the template must ship
!.env.local.example

# Screenshots and the demo gif ARE committed: the write-up references them by
# raw URL, so they must resolve from the repo. Only the raw capture video is
# excluded - it is the source for the gif and nothing links to it.
media/*.webm
